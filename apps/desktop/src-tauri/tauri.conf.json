{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memovi",
  "version": "0.1.0",
  "identifier": "com.memovi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memovi",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis", "msi", "dmg"],
    "publisher": "Trey Israel",
    "copyright": "Copyright (c) 2026 Trey Israel",
    "category": "Productivity",
    "shortDescription": "Memovi flagship desktop client",
    "longDescription": "Self-hosted knowledge platform for durable, organized, retrievable memory.",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
